{
  "name": "@shanelevs/pi-memory-auto",
  "version": "0.3.0",
  "description": "🧠 Memory extension for the pi coding agent — two-layer markdown memory (global + project), cache-safe snapshot injection, keyword/tag/recent search, turn-based auto-extraction, auto-consolidation. Zero heavy deps.",
  "type": "module",
  "main": "index.ts",
  "license": "MIT",
  "author": "Shane",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShaneLevs/pi-memory-auto.git"
  },
  "homepage": "https://github.com/ShaneLevs/pi-memory-auto#readme",
  "bugs": "https://github.com/ShaneLevs/pi-memory-auto/issues",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-package",
    "pi-extension",
    "memory",
    "persistent-memory",
    "agent-memory",
    "two-tier-memory",
    "snapshot-injection",
    "markdown"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
