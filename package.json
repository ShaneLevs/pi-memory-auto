{
  "name": "@shanelevs/pi-memory-auto",
  "version": "0.9.0",
  "description": "🧠 Memory extension for the pi coding agent — memories stored as body + 1-3 keywords, a unique keyword table injected into every session, keyword lookup the agent drives itself, duplicate-merging consolidation every N memories. Zero heavy deps.",
  "type": "module",
  "main": "index.ts",
  "license": "MIT",
  "author": "Shane",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShaneLevs/pi-memory-auto.git"
  },
  "homepage": "https://github.com/ShaneLevs/pi-memory-auto#readme",
  "bugs": "https://github.com/ShaneLevs/pi-memory-auto/issues",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-package",
    "pi-extension",
    "memory",
    "persistent-memory",
    "agent-memory",
    "two-tier-memory",
    "memory-index",
    "markdown"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src",
    "scripts",
    "README.md",
    "README.zh-CN.md",
    "TECHNICAL.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "index:rebuild": "node --experimental-strip-types scripts/rebuild-index.ts",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
